<Window x:Class="ScrcpyZ.PatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Šablon za otključavanje" Width="800" Height="700" MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Crtanje šablona -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="1. Nacrtaj svoj šablon mišem" FontWeight="SemiBold"/>
                <TextBlock Text="Drži levi taster i prevuci preko tačaka, istim redom kao na telefonu."
                           TextWrapping="Wrap" Foreground="#64748B" Margin="0,4,0,10"/>
                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Center">
                    <Canvas x:Name="DrawCanvas" Width="240" Height="240" Background="#FBFCFE" ClipToBounds="True"
                            MouseLeftButtonDown="DrawCanvas_Down" MouseMove="DrawCanvas_Move"
                            MouseLeftButtonUp="DrawCanvas_Up"/>
                </Border>
                <TextBlock x:Name="PatternText" Margin="0,10,0,0" Foreground="#334155"/>
                <Button Content="Obriši" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                        Margin="0,8,0,0" Click="BtnClear_Click"/>
            </StackPanel>
        </Border>

        <!-- 2. Kalibracija tačaka -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="2. Poravnaj tačke sa tačkama na telefonu" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#64748B" Margin="0,4,0,8">
                        Zaključaj telefon i klikni „Pronađi tačke na telefonu“ — program sam pronalazi gde su tačke
                        i snima ekran. Ako ne uspe, klizačima pomeri plave krugove i proveri dugmetom
                        „Probaj na telefonu“ (na telefonu će se videti trag dodira).
                    </TextBlock>
                </StackPanel>

                <Border Grid.Row="1" Background="#1E293B" CornerRadius="6">
                    <Viewbox Margin="6">
                        <Grid>
                            <Image x:Name="Shot" Stretch="Fill"/>
                            <Canvas x:Name="Overlay"/>
                        </Grid>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock x:Name="CenterXLabel" Style="{StaticResource Label}"/>
                    <Slider x:Name="CenterXSlider" Minimum="0.20" Maximum="0.80" SmallChange="0.005"
                            LargeChange="0.02" ValueChanged="Slider_Changed"/>
                    <TextBlock x:Name="CenterLabel" Style="{StaticResource Label}"/>
                    <Slider x:Name="CenterSlider" Minimum="0.30" Maximum="0.95" SmallChange="0.005"
                            LargeChange="0.02" ValueChanged="Slider_Changed"/>
                    <TextBlock x:Name="SpacingLabel" Style="{StaticResource Label}"/>
                    <Slider x:Name="SpacingSlider" Minimum="0.10" Maximum="0.40" SmallChange="0.005"
                            LargeChange="0.02" ValueChanged="Slider_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnShot" Content="Pronađi tačke na telefonu" Style="{StaticResource Btn}"
                                Click="BtnShot_Click"/>
                        <Button x:Name="BtnTest" Content="Probaj na telefonu" Style="{StaticResource Btn}"
                                Click="BtnTest_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"
                   Foreground="#475569" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Otkaži" Style="{StaticResource Btn}" IsCancel="True"/>
            <Button Content="Sačuvaj" Style="{StaticResource Primary}" IsDefault="True" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
