<Window x:Class="ScrcpyZ.PairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uparivanje telefona" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Foreground="#334155" Margin="0,0,0,8">
            Na telefonu: Podešavanja → Opcije za programere → Wireless debugging →
            „Pair device with pairing code“. Upiši IP adresu i port i šestocifreni kod koje telefon prikazuje.
            Uparivanje se radi samo jednom.
        </TextBlock>
        <TextBlock Text="IP adresa i port (npr. 192.168.1.23:37099)" Style="{StaticResource Label}"/>
        <TextBox x:Name="TxtAddress"/>
        <TextBlock Text="Kod za uparivanje" Style="{StaticResource Label}"/>
        <TextBox x:Name="TxtCode"/>
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#B91C1C"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Otkaži" Style="{StaticResource Btn}" IsCancel="True"/>
            <Button x:Name="BtnPair" Content="Upari" Style="{StaticResource Primary}" IsDefault="True" Click="BtnPair_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
