<Window x:Class="ScrcpyZ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScrcpyZ" Width="1000" Height="620" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8"
        FontFamily="Segoe UI" FontSize="13" Icon="ScrcpyZ.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>

        <!-- Naslov -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <TextBlock Text="ScrcpyZ" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock x:Name="ScrcpyPathText" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Lista telefona -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="DeviceList" BorderThickness="0" Margin="4"
                      MouseDoubleClick="DeviceList_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="30" DisplayMemberBinding="{Binding Star}"/>
                        <GridViewColumn Header="Telefon" Width="200" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Veza" Width="60" DisplayMemberBinding="{Binding Connection}"/>
                        <GridViewColumn Header="Adresa" Width="160" DisplayMemberBinding="{Binding AddressText}"/>
                        <GridViewColumn Header="Status" Width="150" DisplayMemberBinding="{Binding StatusText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Podešavanja -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Opcije prikaza" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ChkScreenOff" Content="Ugasi ekran telefona"/>
                    <CheckBox x:Name="ChkStayAwake" Content="Ne dozvoli telefonu da zaspi" ToolTip="Dok scrcpy radi, vreme gašenja ekrana telefona se produžava; po zatvaranju se vraća staro."/>
                    <CheckBox x:Name="ChkNoAudio" Content="Bez zvuka"/>
                    <CheckBox x:Name="ChkOnTop" Content="Uvek iznad ostalih prozora"/>
                    <CheckBox x:Name="ChkFullscreen" Content="Ceo ekran"/>

                    <TextBlock Text="Max. rezolucija (0 = originalna)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TxtMaxSize"/>
                    <TextBlock Text="Bitrate videa (Mbps)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TxtBitrate"/>
                    <TextBlock Text="Dodatni scrcpy argumenti" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TxtExtra"/>

                    <Separator Margin="0,8"/>
                    <TextBlock Text="Otključavanje" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ChkAutoUnlock" Content="Otključaj telefon pri povezivanju"/>
                    <RadioButton x:Name="RbPattern" Content="Šablon (pattern)" GroupName="Lock" Margin="0,6,0,2"
                                 Checked="LockType_Changed"/>
                    <StackPanel x:Name="PatternPanel" Margin="20,2,0,4">
                        <TextBlock x:Name="PatternStatus" Foreground="#475569"/>
                        <Button Content="Podesi šablon…" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                Margin="0,4,0,0" Click="BtnPattern_Click"/>
                    </StackPanel>
                    <RadioButton x:Name="RbPin" Content="PIN / lozinka" GroupName="Lock" Margin="0,2"
                                 Checked="LockType_Changed"/>
                    <PasswordBox x:Name="PinBox" Padding="4,3" Margin="20,2,0,2"/>
                    <TextBlock Text="Čuva se šifrovano, samo za tvoj Windows nalog." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>

                    <Separator Margin="0,8"/>
                    <CheckBox x:Name="ChkAutoConnect" Content="Automatski poveži omiljeni telefon"/>
                    <CheckBox x:Name="ChkAutoRefresh" Content="Automatski osvežavaj listu"/>
                    <CheckBox x:Name="ChkFixedPort" Content="Stalni port 5555 (traži telefon po mreži)"
                              ToolTip="Za mreže koje ne propuštaju mDNS (škola, posao): telefon se prebaci na port 5555, pa ga ScrcpyZ pronalazi i kad dobije novu IP adresu. Posle restarta telefona treba jednom „Poveži na adresu…“."/>
                    <CheckBox x:Name="ChkTray" Content="Posle povezivanja idi u tray"
                              ToolTip="Kad se otvori scrcpy, ScrcpyZ se skloni pored sata. Klik na ikonu ga vraća."/>
                    <Button Content="Folder scrcpy-ja…" Style="{StaticResource Btn}" Margin="0,10,0,0"
                            HorizontalAlignment="Left" Click="BtnFolder_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Dugmad -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" LastChildFill="False">
            <Button Content="⟳  Osveži" Style="{StaticResource Btn}" Click="BtnRefresh_Click"/>
            <Button Content="Upari telefon…" Style="{StaticResource Btn}" Click="BtnPair_Click"/>
            <Button Content="Poveži na adresu…" Style="{StaticResource Btn}" Click="BtnAddress_Click"
                    ToolTip="Ručno povezivanje preko IP:port (iz Wireless debugging na telefonu)"/>
            <Button Content="★  Omiljeni" Style="{StaticResource Btn}" Click="BtnFavorite_Click"
                    ToolTip="Označi izabrani telefon kao omiljeni (za automatsko povezivanje)"/>
            <Button Content="🔓  Otključaj" Style="{StaticResource Btn}" Click="BtnUnlock_Click"
                    ToolTip="Probudi i otključaj izabrani telefon"/>
            <Button Content="Ugasi ekran" Style="{StaticResource Btn}" Click="BtnScreenOff_Click"
                    ToolTip="Ugasi ekran telefona, prikaz u scrcpy-ju ostaje (Alt+O)"/>
            <Button x:Name="BtnConnect" DockPanel.Dock="Right" Content="Poveži" Style="{StaticResource Primary}"
                    Click="BtnConnect_Click"/>
        </DockPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0"
                   Foreground="#475569" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
